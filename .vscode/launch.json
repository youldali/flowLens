{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run FlowLens VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
      ],
      "outFiles": [
        "${workspaceFolder}/apps/vscode-extension/dist/**/*.mjs"
      ],
      "preLaunchTask": "build FlowLens VS Code extension"
    }
  ]
}
