{
  "name": "flowlens-vscode",
  "version": "0.1.1",
  "publisher": "flowlens",
  "displayName": "FlowLens Code Graph",
  "description": "Visualize TypeScript code flow graphs from inside VS Code.",
  "type": "module",
  "main": "./dist/extension.cjs",
  "license": "ISC",
  "icon": "assets/icon.png",
  "preview": true,
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "typescript",
    "flow graph",
    "code analysis",
    "visualization",
    "dependency graph"
  ],
  "galleryBanner": {
    "color": "#102A43",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/youldali/flowLens.git"
  },
  "homepage": "https://github.com/youldali/flowLens/tree/main/apps/vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/youldali/flowLens/issues"
  },
  "engines": {
    "vscode": "^1.104.0"
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onCommand:flowlens.generateGraph",
    "onCommand:flowlens.setAiApiKey",
    "onCommand:flowlens.removeAiApiKey"
  ],
  "contributes": {
    "configuration": {
      "title": "FlowLens",
      "properties": {
        "flowlens.ai.provider": {
          "type": "string",
          "enum": [
            "openai",
            "anthropic"
          ],
          "default": "openai",
          "scope": "application",
          "description": "AI provider used for AI-powered features."
        }
      }
    },
    "commands": [
      {
        "command": "flowlens.generateGraph",
        "title": "FlowLens: Generate Graph"
      },
      {
        "command": "flowlens.setAiApiKey",
        "title": "FlowLens: Set AI API Key"
      },
      {
        "command": "flowlens.removeAiApiKey",
        "title": "FlowLens: Remove AI API Key"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "flowlens.generateGraph",
          "when": "editorTextFocus && (resourceLangId == typescript || resourceLangId == typescriptreact)"
        }
      ]
    }
  },
  "scripts": {
    "build": "node ./scripts/build-frontend.js && node ./scripts/copy-frontend-dist.js && tsc --noEmit -p tsconfig.json && node ./scripts/bundle-extension.js",
    "package": "node ./scripts/package-vsix.js",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "watch": "tsc -w -p tsconfig.json",
    "vscode:prepublish": "node ./scripts/vscode-prepublish.js"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@flowlens/analyzer-core": "workspace:*",
    "@flowlens/code-insights": "workspace:*",
    "@flowlens/common": "workspace:*",
    "@flowlens/registries": "workspace:*",
    "@types/vscode": "1.104.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.12",
    "neverthrow": "^8.2.0",
    "tsx": "^4.23.12",
    "vscode": "^1.1.37"
  }
}
