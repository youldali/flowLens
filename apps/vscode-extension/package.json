{
  "name": "flowlens-vscode-extension",
  "version": "0.0.0",
  "displayName": "FlowLens",
  "description": "VS Code integration for FlowLens.",
  "private": true,
  "type": "module",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.104.0"
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "contributes": {
    "commands": [
      {
        "command": "flowlens.generateGraph",
        "title": "FlowLens: Generate Graph"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "flowlens.generateGraph",
          "when": "editorTextFocus && (resourceLangId == typescript || resourceLangId == typescriptreact)"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "vscode:prepublish": "pnpm run build"
  },
  "devDependencies": {
    "@types/vscode": "1.104.0",
    "typescript": "^6.0.3",
    "vscode": "^1.1.37"
  }
}
