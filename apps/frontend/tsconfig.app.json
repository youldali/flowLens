{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@store": ["./src/store"],
      "@store/*": ["./src/store/*"],
      "@code-analysis-context": ["./src/bounded-contexts/code-analysis-context"],
      "@code-analysis-context/*": ["./src/bounded-contexts/code-analysis-context/*"],
      "@common/*": ["./src/common/*"],
      "@flowlens/analyzer-core/node": ["../../packages/analyzer-core/dist/src/domain/node.d.ts"],
      "@flowlens/analyzer-core/edge": ["../../packages/analyzer-core/dist/src/domain/edge.d.ts"],
      "@flowlens/analyzer-core/flow-graph": ["../../packages/analyzer-core/dist/src/domain/flow-graph.d.ts"],
      "@flowlens/analyzer-core/transformer": ["../../packages/analyzer-core/dist/src/domain/transformer/index.d.ts"],
      "@flowlens/analyzer-core/flow-graph-contract": ["../../packages/analyzer-core/dist/src/domain/flow-graph-contract.d.ts"],
      "@flowlens/analyzer-core/*": ["../../packages/analyzer-core/dist/src/*.d.ts"],
      "@flowlens/common/fs": ["../../packages/common/src/fs/index.ts"],
      "@flowlens/common/utils": ["../../packages/common/src/utils.ts"],
      "@flowlens/common/sorting": ["../../packages/common/src/sorting.ts"],
      "@flowlens/common/queue": ["../../packages/common/src/queue.ts"],
      "@flowlens/registries": ["../../packages/registries/src/index.ts"],
      "@flowlens/registries/vscode-events": ["../../packages/registries/src/vscode-events.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/fixtures/**", "src/common/test-utils/**"]
}
