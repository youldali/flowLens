{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@code-analysis-context": ["./src/bounded-contexts/code-analysis-context"],
      "@code-analysis-context/*": ["./src/bounded-contexts/code-analysis-context/*"],
      "@common/*": ["./src/common/*"],
      "@flowlens/analyzer-core": ["../../packages/analyzer-core/dist/src/index.d.ts"],
      "@flowlens/common": ["../../packages/common/src/index.ts"],
      "@flowlens/registries": ["../../packages/registries/src/index.ts"],
      "@flowlens/registries/vscode-events": ["../../packages/registries/src/vscode-events.ts"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/fixtures/**"]
}
