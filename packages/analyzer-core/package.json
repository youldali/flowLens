{
  "name": "@flowlens/analyzer-core",
  "version": "1.0.0",
  "description": "TypeScript AST parsing and graph generation for FlowLens.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test \"dist/src/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "exports": {
    "./edge": {
      "types": "./dist/src/edge.d.ts",
      "default": "./dist/src/edge.js"
    },
    "./flow-graph": {
      "types": "./dist/src/flow-graph.d.ts",
      "default": "./dist/src/flow-graph.js"
    },
    "./flow-graph-contract": {
      "types": "./dist/src/flow-graph-contract.d.ts",
      "default": "./dist/src/flow-graph-contract.js"
    },
    "./node": {
      "types": "./dist/src/node.d.ts",
      "default": "./dist/src/node.js"
    },
    "./transformer": {
      "types": "./dist/src/transformer/index.d.ts",
      "default": "./dist/src/transformer/index.js"
    },
    "./tsNode": {
      "types": "./dist/src/tsNode.d.ts",
      "default": "./dist/src/tsNode.js"
    }
  },
  "dependencies": {
    "@flowlens/common": "workspace:*",
    "@flowlens/test-utils": "workspace:*",
    "neverthrow": "^8.2.0",
    "typescript": "^6.0.3",
    "zod": "^4.1.13"
  }
}
