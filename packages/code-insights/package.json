{
  "name": "@flowlens/code-insights",
  "version": "1.0.0",
  "description": "AI-assisted code insights for FlowLens.",
  "type": "module",
  "license": "ISC",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test \"dist/**/*.test.js\""
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain/function-explanation-contract": {
      "types": "./dist/domain/function-explanation-contract.d.ts",
      "default": "./dist/domain/function-explanation-contract.js"
    }
  },
  "dependencies": {
    "@flowlens/analyzer-core": "workspace:*",
    "ai": "^7.0.138",
    "neverthrow": "^8.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@flowlens/common": "workspace:*",
    "@flowlens/test-utils": "workspace:*"
  },
  "imports": {
    "#domain/*": {
      "development": "./src/domain/*.ts",
      "default": "./dist/domain/*.js"
    },
    "#common/*": {
      "development": "./src/common/*.ts",
      "default": "./dist/common/*.js"
    }
  }
}
